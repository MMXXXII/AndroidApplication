<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="24sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/player1NameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Имя первого игрока"
        android:text="Игрок 1"/>

    <EditText
        android:id="@+id/player2NameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Имя второго игрока"
        android:visibility="gone"
        android:text="Игрок 2"/>

    <Switch
        android:id="@+id/playerModeSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Игра вдвоем"
        android:layout_marginVertical="8dp"/>

    <com.example.androidapplication.TicTacToeBoard
        android:id="@+id/gameBoard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/resetButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Новая игра"/>

</LinearLayout>